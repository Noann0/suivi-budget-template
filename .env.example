# Copiez ce fichier en .env et gardez .env hors de Git.
NODE_ENV=development
DATABASE_PATH=./data/budget.db

# En local, localhost permet l'enregistrement d'une passkey.
# En production, utilisez votre propre domaine HTTPS.
RP_ID=localhost
ORIGIN=http://localhost:3000
RP_NAME=Suivi budget

# Générez un code privé avec : openssl rand -hex 16
# Il permet le premier enrôlement pendant sept jours.
INITIAL_ENROLLMENT_CODE=

# Ne passer à true que si le serveur n'accepte que les IP du proxy Cloudflare.
TRUST_CF_CONNECTING_IP=false
SESSION_COOKIE_NAME=budget_session
LOG_LEVEL=info
